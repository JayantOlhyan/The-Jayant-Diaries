# ==============================================================================
# The Jayant Diaries — Environment Configuration Contract
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secret keys to source control.
# ==============================================================================

# Application URL (Canonical root domain)
# Local: http://localhost:3000 | Production: https://thejayantdiaries.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER ONLY — Bypasses RLS, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Direct PostgreSQL Connection String (Used for migrations and direct pooling)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Maps Provider Configuration
# ------------------------------------------------------------------------------
# Public token for Mapbox GL or Google Maps API key
NEXT_PUBLIC_MAP_PROVIDER_KEY=pk.your-map-token

# ------------------------------------------------------------------------------
# Analytics & Observability (Optional in development)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_KEY=
